APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codemaster
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO
SESSION_TTL_HOURS=168
VERIFICATION_TTL_HOURS=24
RESET_TTL_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
APP_BASE_URL=http://localhost:3001
MAILER_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@codemaster.local
REDIS_URL=redis://localhost:6379/0
RUNNER_ENABLED=false
RUNNER_QUEUE_NAME=codemaster:execution
MAX_SOURCE_CODE_BYTES=100000
AI_PROVIDER=disabled
AI_MODEL=disabled
AI_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=30
AI_DAILY_REQUEST_LIMIT=20
AI_MAX_INPUT_CHARS=12000
VIDEO_PROVIDER=disabled
VIDEO_ENABLED=false
VIDEO_TOKEN_TTL_SECONDS=900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
SLOW_REQUEST_MS=500
COLLABORATION_ENABLED=false
COLLABORATION_MAX_MESSAGE_BYTES=262144
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN_KEY=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SAML_ENABLED=false
SAML_ENTITY_ID=
SAML_CERTIFICATE=
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
SCIM_ENABLED=false
SECURITY_AUDIT_RETENTION_DAYS=365
