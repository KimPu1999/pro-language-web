# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codemaster
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
APP_BASE_URL=http://localhost:3001
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAILER_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@codemaster.local
REDIS_URL=redis://localhost:6379/0
RUNNER_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=disabled
VIDEO_ENABLED=false
VIDEO_PROVIDER=disabled

# Frontend only needs the public API origin when it is not served through a same-origin rewrite.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Server-only Next.js rewrite target:
API_INTERNAL_URL=http://127.0.0.1:8000

# Database performance
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
SLOW_REQUEST_MS=500

# Collaboration and enterprise integrations. Keep disabled until configured.
COLLABORATION_ENABLED=false
COLLABORATION_MAX_MESSAGE_BYTES=262144
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN_KEY=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SAML_ENABLED=false
SAML_ENTITY_ID=
SAML_CERTIFICATE=
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
SCIM_ENABLED=false
SECURITY_AUDIT_RETENTION_DAYS=365
